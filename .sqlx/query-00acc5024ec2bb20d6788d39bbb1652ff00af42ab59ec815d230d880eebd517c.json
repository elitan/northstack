  "db_name": "SQLite",
  "query": "\n        UPDATE notes SET\n            title      = COALESCE($2, title),\n            body       = COALESCE($3, body),\n            done       = COALESCE($4, done),\n            priority   = COALESCE($5, priority),\n            word_count = CASE WHEN $3 IS NULL THEN word_count ELSE NULL END,\n            updated_at = strftime('%Y-%m-%dT%H:%M:%f+00:00')\n        WHERE id = $1\n        RETURNING id, title, body, done, priority, word_count, created_at, updated_at\n        ",
