  "query": "\n        SELECT\n            count(*)                                   AS \"total!\",\n            count(*) FILTER (WHERE done)               AS \"done!\",\n            COALESCE(sum(word_count), 0)::bigint       AS \"words!\",\n            (SELECT max(day) FROM note_digests)        AS last_digest_day\n        FROM notes\n        ",
