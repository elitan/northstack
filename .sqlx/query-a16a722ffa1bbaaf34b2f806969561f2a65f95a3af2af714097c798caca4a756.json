  "query": "\n        SELECT\n            count(*)                                      AS \"total!: i64\",\n            count(*) FILTER (WHERE done)                  AS \"done!: i64\",\n            COALESCE(sum(word_count), 0)                  AS \"words!: i64\",\n            (SELECT max(day) FROM note_digests)           AS \"last_digest_day: chrono::NaiveDate\"\n        FROM notes\n        ",
